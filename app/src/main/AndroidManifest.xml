<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>

  <application
    android:name=".LaiApplication"
    android:allowBackup="false"
    android:icon="@drawable/ic_lai"
    android:label="@string/app_name"
    android:roundIcon="@drawable/ic_lai"
    android:supportsRtl="true"
    android:theme="@style/Theme.Lai"
    android:usesCleartextTraffic="false">

    <!-- Hexagon FastRPC track (docs/device-results/2026-09-03-redmi-turbo-4-pro-chatterui-fastrpc-comparison.md,
         docs/device-results/2026-09-03-redmi-turbo-4-pro-hexagon-session-open-diagnosis.md):
         a real third-party app (ChatterUI, plain untrusted_app, sideloaded) running the exact
         same upstream ggml-hexagon this app uses successfully opens a FastRPC handle to the cdsp
         domain and loads the v73 HTP skel on this device. This entry (confirmed working: the
         driver now loads and the Hexagon backend registry now constructs, where before nothing
         happened at all) plus app/build.gradle.kts's jniLibs.useLegacyPackaging setting closes
         the two concrete gaps found: (1) libcdsprpc.so needs the app-namespace bridge below to
         dlopen at all;
         (2) the DSP-side loader needs an actual file on disk for the HTP skel .so, which this
         build's default APK packaging never provided (native libs load straight from the
         uncompressed APK, never extracted): ggml-hexagon's session-open call then reads
         ADSP_LIBRARY_PATH (set in LaiApplication.onCreate from applicationInfo.nativeLibraryDir)
         to find it. required="false" keeps this entry a no-op wherever the library or the
         mechanism is unavailable; CPU/Vulkan remain unaffected either way. -->
    <uses-native-library
      android:name="libcdsprpc.so"
      android:required="false" />

    <!-- Adreno OpenCL track, re-attempt (2026-09-04): reverted in commit 82949bb after real-device
         evidence showed this entry causes an indefinite app-launch hang
         (docs/device-results/2026-09-03-redmi-turbo-4-pro-opencl-namespace-hang.md). Root-caused
         since then, not on this manifest entry itself but on the backend-capability probe it
         exposed as a real (rather than instant-failing) vendor call running unguarded on the main
         thread during app startup — MainViewModel's eager `capabilities` read now warms up on
         Dispatchers.IO instead (docs/device-results/2026-09-04-opencl-hang-main-thread-root-cause.md).
         Re-adding this entry now that the main-thread hang class is fixed at the source level, to
         device-revalidate; do not revert again without new evidence distinct from the already-fixed
         threading bug. -->
    <uses-native-library
      android:name="libOpenCL.so"
      android:required="false" />

    <activity
      android:name=".MainActivity"
      android:exported="true"
      android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
      android:windowSoftInputMode="adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
  </application>
</manifest>
